{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify Control stable self-update edge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","channel","latest_version","min_bootstrap_version","source_repository","source_commit","bootstrap","payload_set_sha256","latest_files","updates"],
  "properties": {
    "schema": {"const": 1},
    "channel": {"const": "stable"},
    "latest_version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "min_bootstrap_version": {"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "source_repository": {"const":"sdsssdvx2/spotify-control-updates"},
    "source_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "bootstrap": {
      "type":"object","additionalProperties":false,"required":["version","sha256","size"],
      "properties": {
        "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "size":{"type":"integer","minimum":1,"maximum":1048576}
      }
    },
    "payload_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "latest_files": {
      "type":"array","minItems":3,"maxItems":32,
      "items": {
        "type":"object","additionalProperties":false,"required":["path","sha256","size"],
        "properties": {
          "path":{"type":"string","pattern":"^bin/[A-Za-z0-9._+-]+$"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "size":{"type":"integer","minimum":1,"maximum":20971520}
        }
      }
    },
    "updates": {
      "type":"array","minItems":1,"maxItems":64,
      "items": {
        "type":"object","additionalProperties":false,"required":["from_version","to_version","patches"],
        "properties": {
          "from_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
          "to_version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
          "patches": {
            "type":"array","minItems":1,"maxItems":16,
            "items": {
              "oneOf": [
                {
                  "type":"object","additionalProperties":false,
                  "required":["path","from_sha256","to_sha256","encoding","encoded_sha256","encoded_size","compressed_sha256","compressed_size","json_sha256","json_size","chunks"],
                  "properties": {
                    "path":{"type":"string","pattern":"^bin/[A-Za-z0-9._+-]+$"},
                    "from_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "to_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "encoding":{"const":"gzip-base64-chunks"},
                    "encoded_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "encoded_size":{"type":"integer","minimum":1,"maximum":2097152},
                    "compressed_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "compressed_size":{"type":"integer","minimum":1,"maximum":2097152},
                    "json_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "json_size":{"type":"integer","minimum":1,"maximum":2097152},
                    "chunks":{"$ref":"#/$defs/chunks"}
                  }
                },
                {
                  "type":"object","additionalProperties":false,
                  "required":["path","from_sha256","to_sha256","encoding","encoded_sha256","encoded_size","compressed_sha256","compressed_size","target_size","chunks"],
                  "properties": {
                    "path":{"type":"string","pattern":"^bin/[A-Za-z0-9._+-]+$"},
                    "from_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "to_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "encoding":{"const":"gzip-base64-full-file"},
                    "encoded_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "encoded_size":{"type":"integer","minimum":1,"maximum":4194304},
                    "compressed_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "compressed_size":{"type":"integer","minimum":1,"maximum":4194304},
                    "target_size":{"type":"integer","minimum":1,"maximum":20971520},
                    "chunks":{"$ref":"#/$defs/chunks"}
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "chunks": {
      "type":"array","minItems":1,"maxItems":32,
      "items": {
        "type":"object","additionalProperties":false,"required":["path","sha256","size"],
        "properties": {
          "path":{"type":"string","pattern":"^packages/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9._+-]+/chunk-[0-9]{3}\\.txt$"},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "size":{"type":"integer","minimum":1,"maximum":1048576}
        }
      }
    }
  }
}
